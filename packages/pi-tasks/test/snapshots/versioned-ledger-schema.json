{
  "eventEnvelope": {
    "id": "originos.pi-tasks.event-envelope.v2",
    "kinds": ["mutation", "snapshot"],
    "mutationRequired": ["version", "kind", "revision", "parentCursor", "requestId", "payloadHash", "command", "event"],
    "snapshotRequired": ["version", "kind", "revision", "parentCursor", "event", "checkpoint"]
  },
  "stateEvent": {
    "id": "originos.pi-tasks.state-event.v2",
    "required": ["version", "reason", "widgetId", "scope", "stateHash", "state"],
    "reasons": ["session_start", "session_tree", "task_mutation", "compaction"],
    "sessionIdType": "string"
  },
  "originosCommand": {
    "type": "object",
    "additionalProperties": false,
    "required": ["version", "request_id", "expected_revision", "expected_cursor"],
    "properties": {
      "version": { "const": 1 },
      "request_id": { "type": "string", "minLength": 1 },
      "expected_revision": { "type": "integer", "minimum": 0 },
      "expected_cursor": { "type": ["string", "null"], "minLength": 1 }
    }
  }
}
