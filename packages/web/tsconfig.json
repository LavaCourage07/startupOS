{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "noEmit": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@neural-nexus/neural-channel": ["./src/modules/neural-channel/src"],
      "@neural-nexus/view-manager": ["./src/modules/view-manager/src"],
      "@neural-nexus/view-reconciler": ["./src/modules/view-reconciler/src"],
      "@neural-nexus/mcp-in-browser": ["./src/modules/mcp-in-browser/src"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", "out", "dist", "../core"]
}
